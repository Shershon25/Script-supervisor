# Script Supervisor MVP Environment Configuration Example
# Copy this file to .env and configure environment variables before deployment.

# Database Connection (CockroachDB / PostgreSQL)
DATABASE_URL=postgresql://root@localhost:26257/script_supervisor?sslmode=disable

# Environment & Security Mode ('development' or 'production')
# In 'development': GEMINI_PROVIDER=vertexai uses local gcloud ADC (gcloud auth application-default login)
# In 'production': GEMINI_PROVIDER=vertexai uses Cloud Run attached Service Account ADC automatically
ENVIRONMENT=production
DEBUG=false

# Application & CORS Settings (Comma-separated allowed origins)
FRONTEND_URL=https://script-supervisor.example.com
NEXT_PUBLIC_API_URL=https://api.script-supervisor.example.com
CORS_ORIGINS=https://script-supervisor.example.com,https://api.script-supervisor.example.com

# Gemini API Credentials
# Gemini Provider Mode: 'developer' (Developer API key) or 'vertexai' (Google Cloud Vertex AI ADC)
GEMINI_PROVIDER=developer
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud Vertex AI Settings (Used only if GEMINI_PROVIDER=vertexai)
# Authenticates via gcloud ADC in 'development' & attached Service Account on Cloud Run in 'production'. No JSON key file required.
GCP_PROJECT_ID=your_gcp_project_id
GCP_LOCATION=global

# Parallel API Key (External Research Service)
PARALLEL_API_KEY=your_parallel_api_key_here
