# Script Supervisor MVP Environment Configuration Example (Root)
# Copy this file to .env in the repository root directory.

# Database Connection (CockroachDB / PostgreSQL)
DATABASE_URL=postgresql://root@localhost:26257/script_supervisor?sslmode=disable

# Environment & Transport Configuration
ENVIRONMENT=production
DEBUG=false
FRONTEND_URL=https://script-supervisor.example.com
NEXT_PUBLIC_API_URL=https://api.script-supervisor.example.com
CORS_ORIGINS=https://script-supervisor.example.com,https://api.script-supervisor.example.com

# Gemini Provider Mode: 'developer' (uses GEMINI_API_KEY) or 'vertexai' (uses GCP_PROJECT_ID)
GEMINI_PROVIDER=developer
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud Vertex AI Settings (Used when GEMINI_PROVIDER=vertexai)
GCP_PROJECT_ID=your_gcp_project_id
GCP_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-service-account-key.json

# Parallel API Key
PARALLEL_API_KEY=your_parallel_api_key_here
